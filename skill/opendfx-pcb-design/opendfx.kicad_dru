# OpenDFX design rules for KiCad 10
#
# From "OpenDFX for Printed Circuit Boards" by Chris Denney, https://opendfx.org
# Licensed under the MIT License: https://opensource.org/license/mit
# Generated by tools/build_kicad_rules.py from tools/kicad_rules.yaml. Don't edit by hand.
#
# How to use it: https://opendfx.org/kicad/
#   1. Copy this file into your project folder and rename it to match your project,
#      for example myboard.kicad_dru next to myboard.kicad_pro.
#      Or paste it into Board Setup, Design Rules, Custom Rules.
#      If your project already has a .kicad_dru file, keep it unchanged until you have
#      checked how the two sets of rules interact. When two rules of the same kind apply
#      to the same item, KiCad uses the later one. One OpenDFX rule also changes how pads
#      join copper pours when the zones are refilled. Follow the steps at
#      https://opendfx.org/00-start-here/05-using-this-book-with-an-ai-agent/#if-the-project-already-has-a-rules-file
#   2. Set Board Setup, Solder Mask/Paste, Minimum web width to 0.1 mm (PCB-DFA-032).
#   3. Run the design rule check (Inspect, Design Rules Checker).
#
# These rules add to KiCad's own checks. They never loosen your net class clearances
# or your Board Setup minimums, except where a rule says so.
#
# Recommended values are checked across the whole board. Where a design really needs to be tighter,
# draw a rule area (Place, Add Rule Area) and name it "OpenDFX minimum". Inside it, the minimum values
# are checked instead. The fab and the assembler can then see every tight spot.
#
# Each rule names its recommendation and its address in the book, such as opendfx.org/PCB-DFM-020.
# These are recommendations, not rules: if your fab or assembler can do better, follow them.

(version 1)

# Trace width. PCB-DFM-020
(rule "PCB-DFM-020: traces at least 0.15 mm wide (opendfx.org/PCB-DFM-020)"
  (constraint assertion "A.Width >= 0.15mm")
  (condition "(A.Type == 'Track' || A.Type == 'Arc') && !A.intersectsArea('OpenDFX minimum*')"))
(rule "PCB-DFM-020: traces at least 0.1 mm wide, inside an OpenDFX minimum area (opendfx.org/PCB-DFM-020)"
  (constraint assertion "A.Width >= 0.1mm")
  (condition "(A.Type == 'Track' || A.Type == 'Arc') && A.intersectsArea('OpenDFX minimum*')"))

# Spacing between copper on different nets, including pours. PCB-DFM-020, PCB-DFM-029
(rule "PCB-DFM-020: copper at least 0.15 mm from copper on another net (opendfx.org/PCB-DFM-020)"
  (constraint physical_clearance (min 0.15mm))
  (condition "A.Net != B.Net && A.Layer == '*.Cu' && B.Layer == '*.Cu' && !(A.intersectsArea('OpenDFX minimum*') || B.intersectsArea('OpenDFX minimum*'))"))
(rule "PCB-DFM-020: copper at least 0.1 mm from copper on another net, inside an OpenDFX minimum area (opendfx.org/PCB-DFM-020)"
  (constraint physical_clearance (min 0.1mm))
  (condition "A.Net != B.Net && A.Layer == '*.Cu' && B.Layer == '*.Cu' && (A.intersectsArea('OpenDFX minimum*') || B.intersectsArea('OpenDFX minimum*'))"))

# Copper on another net to the edge of a drilled hole, on every layer. PCB-DFM-022, PCB-DFM-007
(rule "PCB-DFM-022: copper at least 0.25 mm from the edge of a drilled hole (opendfx.org/PCB-DFM-022)"
  (constraint physical_hole_clearance (min 0.25mm))
  (condition "A.Net != B.Net && L == '*.Cu' && !(A.intersectsArea('OpenDFX minimum*') || B.intersectsArea('OpenDFX minimum*'))"))
(rule "PCB-DFM-022: copper at least 0.2 mm from the edge of a drilled hole, inside an OpenDFX minimum area (opendfx.org/PCB-DFM-022)"
  (constraint physical_hole_clearance (min 0.2mm))
  (condition "A.Net != B.Net && L == '*.Cu' && (A.intersectsArea('OpenDFX minimum*') || B.intersectsArea('OpenDFX minimum*'))"))

# Finished diameter of a drilled hole, except laser microvias. PCB-DFM-024
(rule "PCB-DFM-024: drilled holes at least 0.25 mm in diameter (opendfx.org/PCB-DFM-024)"
  (constraint assertion "A.Hole >= 0.25mm")
  (condition "A.Type == 'Via' && !A.isMicroVia() && !A.intersectsArea('OpenDFX minimum*')"))
(rule "PCB-DFM-024: drilled holes at least 0.25 mm in diameter (opendfx.org/PCB-DFM-024)"
  (constraint assertion "A.Hole_Size_X >= 0.25mm && A.Hole_Size_Y >= 0.25mm")
  (condition "A.Pad_Type == 'Through-hole' && !A.intersectsArea('OpenDFX minimum*')"))
(rule "PCB-DFM-024: drilled holes at least 0.2 mm in diameter, inside an OpenDFX minimum area (opendfx.org/PCB-DFM-024)"
  (constraint assertion "A.Hole >= 0.2mm")
  (condition "A.Type == 'Via' && !A.isMicroVia() && A.intersectsArea('OpenDFX minimum*')"))
(rule "PCB-DFM-024: drilled holes at least 0.2 mm in diameter, inside an OpenDFX minimum area (opendfx.org/PCB-DFM-024)"
  (constraint assertion "A.Hole_Size_X >= 0.2mm && A.Hole_Size_Y >= 0.2mm")
  (condition "A.Pad_Type == 'Through-hole' && A.intersectsArea('OpenDFX minimum*')"))

# Annular ring on plated holes and vias. PCB-DFM-026
(rule "PCB-DFM-026: an annular ring of at least 0.15 mm (opendfx.org/PCB-DFM-026)"
  (constraint assertion "(A.Diameter - A.Hole) / 2 >= 0.15mm")
  (condition "A.Type == 'Via' && !A.isMicroVia() && !A.intersectsArea('OpenDFX minimum*')"))
(rule "PCB-DFM-026: an annular ring of at least 0.15 mm (opendfx.org/PCB-DFM-026)"
  (constraint assertion "(A.Size_X - A.Hole_Size_X) / 2 >= 0.15mm && (A.Size_Y - A.Hole_Size_Y) / 2 >= 0.15mm")
  (condition "A.Pad_Type == 'Through-hole' && !A.intersectsArea('OpenDFX minimum*')"))
(rule "PCB-DFM-026: an annular ring of at least 0.125 mm, inside an OpenDFX minimum area (opendfx.org/PCB-DFM-026)"
  (constraint assertion "(A.Diameter - A.Hole) / 2 >= 0.125mm")
  (condition "A.Type == 'Via' && !A.isMicroVia() && A.intersectsArea('OpenDFX minimum*')"))
(rule "PCB-DFM-026: an annular ring of at least 0.125 mm, inside an OpenDFX minimum area (opendfx.org/PCB-DFM-026)"
  (constraint assertion "(A.Size_X - A.Hole_Size_X) / 2 >= 0.125mm && (A.Size_Y - A.Hole_Size_Y) / 2 >= 0.125mm")
  (condition "A.Pad_Type == 'Through-hole' && A.intersectsArea('OpenDFX minimum*')"))

# Copper to the board edge. PCB-DFM-002
(rule "PCB-DFM-002: copper at least 0.5 mm from the board edge (opendfx.org/PCB-DFM-002)"
  (constraint edge_clearance (min 0.5mm))
  (condition "A.Layer == '*.Cu' && !A.intersectsArea('OpenDFX minimum*')"))
(rule "PCB-DFM-002: copper at least 0.25 mm from the board edge, inside an OpenDFX minimum area (opendfx.org/PCB-DFM-002)"
  (constraint edge_clearance (min 0.25mm))
  (condition "A.Layer == '*.Cu' && A.intersectsArea('OpenDFX minimum*')"))

# No copper pad on a non-plated hole. PCB-DFM-007
(rule "PCB-DFM-007: no copper pad on a non-plated hole (opendfx.org/PCB-DFM-007)"
  (constraint assertion "A.Size_X <= A.Hole_Size_X && A.Size_Y <= A.Hole_Size_Y")
  (condition "A.Pad_Type == 'NPTH, mechanical'"))

# Width of a routed non-plated slot. PCB-DFM-042
(rule "PCB-DFM-042: non-plated slots at least 1 mm wide (opendfx.org/PCB-DFM-042)"
  (constraint assertion "A.Hole_Size_X >= 1mm && A.Hole_Size_Y >= 1mm")
  (condition "A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X != A.Hole_Size_Y"))

# Width of a routed plated slot. PCB-DFM-042
(rule "PCB-DFM-042: plated slots at least 1 mm wide (opendfx.org/PCB-DFM-042)"
  (constraint assertion "A.Hole_Size_X >= 1mm && A.Hole_Size_Y >= 1mm")
  (condition "A.Pad_Type == 'Through-hole' && A.Hole_Size_X != A.Hole_Size_Y && !A.intersectsArea('OpenDFX minimum*')"))
(rule "PCB-DFM-042: plated slots at least 0.5 mm wide, inside an OpenDFX minimum area (opendfx.org/PCB-DFM-042)"
  (constraint assertion "A.Hole_Size_X >= 0.5mm && A.Hole_Size_Y >= 0.5mm")
  (condition "A.Pad_Type == 'Through-hole' && A.Hole_Size_X != A.Hole_Size_Y && A.intersectsArea('OpenDFX minimum*')"))

# Height of legend text. PCB-DFM-039
(rule "PCB-DFM-039: legend text at least 1 mm tall (opendfx.org/PCB-DFM-039)"
  (constraint assertion "A.Height >= 1mm")
  (condition "A.Layer == '*.SilkS' && A.Visible && !A.intersectsArea('OpenDFX minimum*')"))
(rule "PCB-DFM-039: legend text at least 0.8 mm tall, inside an OpenDFX minimum area (opendfx.org/PCB-DFM-039)"
  (constraint assertion "A.Height >= 0.8mm")
  (condition "A.Layer == '*.SilkS' && A.Visible && A.intersectsArea('OpenDFX minimum*')"))

# Line width of legend text. PCB-DFM-039
(rule "PCB-DFM-039: legend text drawn with lines at least 0.15 mm wide (opendfx.org/PCB-DFM-039)"
  (constraint assertion "A.Thickness >= 0.15mm")
  (condition "A.Layer == '*.SilkS' && A.Visible"))

# Legend to exposed copper and holes. PCB-DFM-040, PCB-DFM-045
(rule "PCB-DFM-040: legend at least 0.1 mm from exposed copper (opendfx.org/PCB-DFM-040)"
  (constraint silk_clearance (min 0.1mm))
  (condition "L == '*.Mask'"))

# Diameter of a test point pad. PCB-DFT-008
(rule "PCB-DFT-008: test point pads at least 1.0 mm in diameter (opendfx.org/PCB-DFT-008)"
  (constraint assertion "A.Size_X >= 1.0mm && A.Size_Y >= 1.0mm")
  (condition "A.Fabrication_Property == 'Test point pad' && !A.intersectsArea('OpenDFX minimum*')"))
(rule "PCB-DFT-008: test point pads at least 0.9 mm in diameter, inside an OpenDFX minimum area (opendfx.org/PCB-DFT-008)"
  (constraint assertion "A.Size_X >= 0.9mm && A.Size_Y >= 0.9mm")
  (condition "A.Fabrication_Property == 'Test point pad' && A.intersectsArea('OpenDFX minimum*')"))

# Spacing of test points, center to center. PCB-DFT-008
(rule "PCB-DFT-008: test points at least 2.54 mm apart, center to center (opendfx.org/PCB-DFT-008)"
  (constraint physical_clearance (min "2.54mm - 1.0mm"))
  (condition "A.Fabrication_Property == 'Test point pad' && B.Fabrication_Property == 'Test point pad' && A.Layer == '*.Cu' && !(A.intersectsArea('OpenDFX minimum*') || B.intersectsArea('OpenDFX minimum*'))"))
(rule "PCB-DFT-008: test points at least 1.9 mm apart, center to center, inside an OpenDFX minimum area (opendfx.org/PCB-DFT-008)"
  (constraint physical_clearance (min "1.9mm - 0.9mm"))
  (condition "A.Fabrication_Property == 'Test point pad' && B.Fabrication_Property == 'Test point pad' && A.Layer == '*.Cu' && (A.intersectsArea('OpenDFX minimum*') || B.intersectsArea('OpenDFX minimum*'))"))

# Test point to the board edge. PCB-DFT-009
(rule "PCB-DFT-009: test points at least 5 mm from the board edge (opendfx.org/PCB-DFT-009)"
  (constraint edge_clearance (min 5mm))
  (condition "A.Fabrication_Property == 'Test point pad' && !A.intersectsArea('OpenDFX minimum*')"))
(rule "PCB-DFT-009: test points at least 3 mm from the board edge, inside an OpenDFX minimum area (opendfx.org/PCB-DFT-009)"
  (constraint edge_clearance (min 3mm))
  (condition "A.Fabrication_Property == 'Test point pad' && A.intersectsArea('OpenDFX minimum*')"))

# Bottom surface-mount pads to through-hole pads, for wave or selective soldering. PCB-DFA-043
(rule "PCB-DFA-043: bottom surface-mount pads at least 3 mm from through-hole pads (wave or selective soldering) (opendfx.org/PCB-DFA-043)"
  (layer "B.Cu")
  (constraint physical_clearance (min 3mm))
  (condition "(A.Pad_Type == 'Through-hole' && B.Pad_Type == 'SMD') || (A.Pad_Type == 'SMD' && B.Pad_Type == 'Through-hole') && !(A.intersectsArea('OpenDFX minimum*') || B.intersectsArea('OpenDFX minimum*'))")
  (severity warning))
(rule "PCB-DFA-043: bottom surface-mount pads at least 2 mm from through-hole pads (wave or selective soldering), inside an OpenDFX minimum area (opendfx.org/PCB-DFA-043)"
  (layer "B.Cu")
  (constraint physical_clearance (min 2mm))
  (condition "(A.Pad_Type == 'Through-hole' && B.Pad_Type == 'SMD') || (A.Pad_Type == 'SMD' && B.Pad_Type == 'Through-hole') && (A.intersectsArea('OpenDFX minimum*') || B.intersectsArea('OpenDFX minimum*'))")
  (severity warning))

# Through-hole pads join copper pours through thermal reliefs. PCB-DFA-044
(rule "PCB-DFA-044: through-hole pads join pours through thermal reliefs (opendfx.org/PCB-DFA-044)"
  (constraint zone_connection thermal_reliefs)
  (condition "A.Pad_Type == 'Through-hole'"))

# Optional: keep parts 3 mm from the board edges, so the board can run without rails (PCB-DFA-015).
# The book says this is generally not possible, so the rules are switched off. Remove the "#" to use them.
#(rule "PCB-DFA-015: parts at least 3 mm from the board edge, to run without rails (opendfx.org/PCB-DFA-015)"
#  (layer "F.Courtyard")
#  (constraint physical_clearance (min 3mm))
#  (condition "B.Layer == 'Edge.Cuts'"))
#(rule "PCB-DFA-015: parts at least 3 mm from the board edge, to run without rails (opendfx.org/PCB-DFA-015)"
#  (layer "B.Courtyard")
#  (constraint physical_clearance (min 3mm))
#  (condition "B.Layer == 'Edge.Cuts'"))

# Optional: 2 oz finished copper (PCB-DFM-020). Traces and spacing at least 0.25 mm, and 0.2 mm inside an
# OpenDFX minimum area. Remove the "#" to use these rules on a 2 oz board.
#(rule "PCB-DFM-020: traces at least 0.25 mm wide on 2 oz copper (opendfx.org/PCB-DFM-020)"
#  (constraint assertion "A.Width >= 0.25mm")
#  (condition "(A.Type == 'Track' || A.Type == 'Arc') && !A.intersectsArea('OpenDFX minimum*')"))
#(rule "PCB-DFM-020: traces at least 0.2 mm wide on 2 oz copper, inside an OpenDFX minimum area (opendfx.org/PCB-DFM-020)"
#  (constraint assertion "A.Width >= 0.2mm")
#  (condition "(A.Type == 'Track' || A.Type == 'Arc') && A.intersectsArea('OpenDFX minimum*')"))
#(rule "PCB-DFM-020: copper at least 0.25 mm from copper on another net, on 2 oz copper (opendfx.org/PCB-DFM-020)"
#  (constraint physical_clearance (min 0.25mm))
#  (condition "A.Net != B.Net && A.Layer == '*.Cu' && B.Layer == '*.Cu' && !(A.intersectsArea('OpenDFX minimum*') || B.intersectsArea('OpenDFX minimum*'))"))
#(rule "PCB-DFM-020: copper at least 0.2 mm from copper on another net, on 2 oz copper, inside an OpenDFX minimum area (opendfx.org/PCB-DFM-020)"
#  (constraint physical_clearance (min 0.2mm))
