---
// One short permanent address per recommendation (Q136): /PCB-DFA-006/ forwards to its place in the book.
// The list comes from data/recommendations.json through tools/build_site.py.
import permalinks from '../generated/permalinks.json';

export function getStaticPaths() {
  return Object.entries(permalinks).map(([id, { to, title }]) => ({ params: { id }, props: { id, to, title } }));
}

const { id, to, title } = Astro.props;
const canonical = new URL(to, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{id}: {title}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <script is:inline define:vars={{ to }}>location.replace(to);</script>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 3rem auto; padding: 0 1rem; line-height: 1.5; }
    </style>
  </head>
  <body>
    <p><a href={to}>{id}: {title}</a></p>
  </body>
</html>
