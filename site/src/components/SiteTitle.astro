---
// Starlight's site title with ™ after OpenDFX (M7, Q203). The ™ is left out of the configured title,
// so browser tabs, search results and the data files keep the plain name. The logo's symbol (M44) sits before it;
// it is decorative, because the title beside it says the name.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const shown = siteTitle.replace('OpenDFX', 'OpenDFX™');
---

<a href={siteTitleHref} class="site-title sl-flex">
	<img src="/brand/opendfx-symbol-green.svg" alt="" width="32" height="32" class="logo" />
	<span translate="no">{shown}</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			font-size: var(--sl-text-h4);
			font-weight: 600;
			color: var(--sl-color-text-accent);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		span {
			overflow: hidden;
		}
		.logo {
			flex: none;
			width: 2rem;
			height: 2rem;
		}
	}
</style>
